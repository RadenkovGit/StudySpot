@model IReadOnlyList<StudySpot.ViewModels.StudySessions.StudySessionListItemViewModel>

@{
    ViewData["Title"] = "Home";
}

<section class="py-5 text-center">
    <h1 class="display-5 fw-bold">StudySpot</h1>
    <p class="lead mx-auto home-lead">
        Keep a personal catalog of the places where you study best and log the study sessions you spend there.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary" asp-controller="StudyPlaces" asp-action="Index">Browse study places</a>
        <a class="btn btn-success" asp-controller="StudySessions" asp-action="Create">Record a session</a>
    </div>
</section>

<section class="row g-4 text-center">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Your study places</h2>
                <p class="card-text text-muted">
                    Libraries, cafes, university halls or a desk at home, with notes on Wi-Fi and power outlets.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Your study history</h2>
                <p class="card-text text-muted">
                    Record how long you studied and see which places you keep coming back to.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0">Recent study sessions</h2>
        @if (Model.Count > 0)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-controller="StudySessions" asp-action="Index">View all sessions</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not recorded any study sessions yet.
            <a asp-controller="StudySessions" asp-action="Create">Record your first session</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Place</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@session.Date.ToString("yyyy-MM-dd")</td>
                            <td class="text-break">
                                <a asp-controller="StudyPlaces" asp-action="Details" asp-route-id="@session.StudyPlaceId">@session.PlaceName</a>
                            </td>
                            <td class="text-nowrap">@session.DurationMinutes min</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
