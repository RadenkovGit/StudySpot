@{
    ViewData["Title"] = "Home";
}

<section class="py-5 text-center">
    <h1 class="display-5 fw-bold">StudySpot</h1>
    <p class="lead mx-auto home-lead">
        Keep a personal catalog of the places where you study best and log the study sessions you spend there.
    </p>
    <a class="btn btn-primary" asp-controller="StudyPlaces" asp-action="Index">Browse study places</a>
    <a class="btn btn-success" asp-controller="StudySessions" asp-action="Create">Record a session</a>
</section>

<section class="row g-4 text-center">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Your study places</h2>
                <p class="card-text text-muted">
                    Libraries, cafes, university halls or a desk at home, with notes on Wi-Fi and power outlets.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Your study history</h2>
                <p class="card-text text-muted">
                    Record how long you studied and see which places you keep coming back to.
                </p>
            </div>
        </div>
    </div>
</section>
