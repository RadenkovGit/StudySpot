@model StudyPlaceDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<h1 class="mb-1">@Model.Name</h1>
<p class="text-muted">@Model.PlaceTypeName</p>

<dl class="row">
    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>

    <dt class="col-sm-3">Wi-Fi</dt>
    <dd class="col-sm-9">@(Model.HasWifi ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Power outlets</dt>
    <dd class="col-sm-9">@(Model.HasPowerOutlets ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)</dd>
</dl>

<a class="btn btn-success" asp-controller="StudySessions" asp-action="Create" asp-route-placeId="@Model.Id">Record session</a>
<a class="btn btn-outline-success" asp-controller="StudySessions" asp-action="Index" asp-route-placeId="@Model.Id">Session history</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
<a class="btn btn-outline-secondary" asp-action="Index">Back to places</a>
