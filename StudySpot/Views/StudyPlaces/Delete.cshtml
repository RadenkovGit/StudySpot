@model StudyPlaceDeleteViewModel

@{
    ViewData["Title"] = "Delete study place";
}

<h1 class="mb-4">Delete study place</h1>

<div class="alert alert-danger">
    <p class="mb-1">Are you sure you want to delete this study place?</p>
    @if (Model.SessionsCount > 0)
    {
        <strong>
            @Model.SessionsCount study @(Model.SessionsCount == 1 ? "session" : "sessions") recorded for this place will be deleted too.
        </strong>
    }
    else
    {
        <span>No study sessions are recorded for this place.</span>
    }
    <div class="mt-1">This action cannot be undone.</div>
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9 text-break">@Model.Name</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.PlaceTypeName</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9 text-break">@Model.Location</dd>

    <dt class="col-sm-3">Study sessions</dt>
    <dd class="col-sm-9">@Model.SessionsCount</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Back to details</a>
</form>
