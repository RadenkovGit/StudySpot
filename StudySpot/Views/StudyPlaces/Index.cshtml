@model StudyPlaceIndexViewModel

@{
    ViewData["Title"] = "Study places";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Study places</h1>
    <a class="btn btn-primary" asp-action="Create">Add place</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-md-5">
        <label for="search" class="form-label">Search</label>
        <input id="search" name="search" value="@Model.Search" maxlength="120" class="form-control" placeholder="Name or location" />
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <label for="typeId" class="form-label">Type</label>
        <select id="typeId" name="typeId" asp-items="Model.PlaceTypes" class="form-select">
            <option value="">All types</option>
        </select>
    </div>
    <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Places.Count == 0)
{
    if (Model.HasFilters)
    {
        <div class="alert alert-info">
            No study places match your search. <a asp-action="Index">Clear the filters</a> to see all places.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have no study places yet. <a asp-action="Create">Add your first place</a>.
        </div>
    }
}
else
{
    @if (Model.HasFilters)
    {
        <p class="text-muted">@Model.Places.Count @(Model.Places.Count == 1 ? "place" : "places") found.</p>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th class="d-none d-md-table-cell">Location</th>
                    <th class="d-none d-sm-table-cell text-nowrap">Wi-Fi</th>
                    <th class="d-none d-sm-table-cell">Power outlets</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var place in Model.Places)
                {
                    <tr>
                        <td class="text-break">
                            @place.Name
                            <div class="d-md-none small text-muted text-break">@place.Location</div>
                            <div class="d-sm-none small text-muted">
                                Wi-Fi: @(place.HasWifi ? "yes" : "no") &middot; Power outlets: @(place.HasPowerOutlets ? "yes" : "no")
                            </div>
                        </td>
                        <td>@place.PlaceTypeName</td>
                        <td class="d-none d-md-table-cell text-break">@place.Location</td>
                        <td class="d-none d-sm-table-cell">@(place.HasWifi ? "Yes" : "No")</td>
                        <td class="d-none d-sm-table-cell">@(place.HasPowerOutlets ? "Yes" : "No")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@place.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
