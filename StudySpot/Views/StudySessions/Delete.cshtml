@model StudySessionListItemViewModel

@{
    ViewData["Title"] = "Delete study session";
}

<h1 class="mb-4">Delete study session</h1>

<div class="alert alert-danger">
    <p class="mb-1">Are you sure you want to delete this study session?</p>
    <div>This action cannot be undone.</div>
</div>

<dl class="row">
    <dt class="col-sm-3">Place</dt>
    <dd class="col-sm-9 text-break">@Model.PlaceName</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Duration</dt>
    <dd class="col-sm-9">@Model.DurationMinutes min</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9 text-break">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to sessions</a>
</form>
